# --- Python (match at any depth) ---
__pycache__/
*.py[cod]
*.so
*.egg-info/
build/
dist/
.eggs/

# --- envs ---
.venv/
.venv-*/
env/
venv/

# --- tooling caches ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# --- ML / data / weights (NEVER commit) ---
# Root-anchored on purpose. An unanchored `calib/` silently ignored the
# src/mcreid/calib source package, so the core calibration module never made it
# into a commit while every local test still passed. Anchor output directories.
/data/
/weights/
*.pt
*.pth
*.onnx
*.engine
*.npy
*.npz

# --- footage & recordings ---
/footage/
/recordings/
*.mp4
*.mov
*.avi
*.mkv
*.gif
# Whitelist ONE vetted asset by exact name, not a directory glob. The previous
# `!docs/assets/*.gif` let a 5.9 MB animation of real WILDTRACK frames into
# history — the dataset this repo promises never to commit (see
# scripts/download_wildtrack.py). The rule is about the pixels, not the
# extension: anything rendered from third-party or room footage stays out, and
# a new asset here needs a deliberate line of its own.
!docs/assets/cardboard_demo.gif

# --- calibration produced from my room (personal) ---
/calib/
*.calib.json

# --- outputs ---
/outputs/
/logs/
/results/
/runs/
# Calibration reports embed frames of my room — same class as footage.
/reports/
*.log

# --- internal working logs (local only, deliberately untracked) ---
# These are session notes, not documentation. They describe the room, the rig
# and the hardware they were recorded on, and they were rewritten out of history
# rather than merely untracked. Keep editing them locally; they are the project's
# memory and the session protocol still depends on them.
/status.txt
/context.md
/capture_guide.md

# --- editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
