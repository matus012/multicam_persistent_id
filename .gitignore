# --- Python (match at any depth) ---
__pycache__/
*.py[cod]
*.so
*.egg-info/
build/
dist/
.eggs/

# --- envs ---
.venv/
.venv-*/
env/
venv/

# --- tooling caches ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# --- ML / data / weights (NEVER commit) ---
# Root-anchored on purpose. An unanchored `calib/` silently ignored the
# src/mcreid/calib source package, so the core calibration module never made it
# into a commit while every local test still passed. Anchor output directories.
/data/
/weights/
*.pt
*.pth
*.onnx
*.engine
*.npy
*.npz

# --- footage & recordings ---
/footage/
/recordings/
*.mp4
*.mov
*.avi
*.mkv
*.gif
!docs/assets/*.gif

# --- calibration produced from my room (personal) ---
/calib/
*.calib.json

# --- outputs ---
/outputs/
/logs/
/results/
/runs/
*.log

# --- editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
